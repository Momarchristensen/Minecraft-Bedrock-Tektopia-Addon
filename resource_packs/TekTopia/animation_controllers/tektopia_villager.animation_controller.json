{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.tektopia_villager": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": [
						{
							"chop": "query.property('property:animation') == 'chopping'"
						},
						{
							"harvest": "query.property('property:animation') == 'harvesting'"
						},
						{
							"planting": "query.property('property:animation') == 'planting'"
						},
						{
							"tilling": "query.property('property:animation') == 'tilling'"
						},
						{
							"mining": "query.property('property:animation') == 'mining'"
						}
					],
					"transitions": [
						{
							"walking": "query.ground_speed > 1.0"
						}
					],
					"blend_transition": {
						"0.0": 1,
						"0.0556": 0.96985,
						"0.1111": 0.88302,
						"0.1667": 0.75,
						"0.2222": 0.58682,
						"0.2778": 0.41318,
						"0.3333": 0.25,
						"0.3889": 0.11698,
						"0.4444": 0.03015,
						"0.5": 0
					},
					"blend_via_shortest_path": true
				},
				"walking": {
					"animations": [
						"walk"
					],
					"transitions": [
						{
							"idle": "query.ground_speed < 0.5"
						}
					],
					"blend_transition": {
						"0.0": 1,
						"0.0556": 0.96985,
						"0.1111": 0.88302,
						"0.1667": 0.75,
						"0.2222": 0.58682,
						"0.2778": 0.41318,
						"0.3333": 0.25,
						"0.3889": 0.11698,
						"0.4444": 0.03015,
						"0.5": 0
					},
					"blend_via_shortest_path": true
				}
			}
		}
	}
}