{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.pig.v4.wireframe_mask": {
      "arrays": {
        "textures": {
          "Array.default": [
            "Texture.wireframe_default",
            "Texture.wireframe_warm",
            "Texture.wireframe_cold"
          ],
          "Array.baby": [
            "Texture.wireframe_baby_default",
            "Texture.wireframe_baby_warm",
            "Texture.wireframe_baby_cold"
          ]
        }
      },
      "geometry": "query.is_baby ? Geometry.baby_mask : Geometry.default_mask",
      "materials": [
        {
          "*": "Material.wireframe_mask"
        }
      ],
      "textures": [
        "query.is_baby ? Array.baby[v.index] : Array.default[v.index]"
      ]
    },
