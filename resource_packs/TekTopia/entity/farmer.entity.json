{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "tektopia:farmer",
            "enable_attachables": true,
            "animations": {
                "main": "controller.animation.tektopia_villager",
                "walk": "animation.tektopia_villager.walk",
                "harvest": "animation.tektopia_villager.pickup"
            },
            "scripts": {
                "animate": [
                    "main",
                    {
                        "harvest": "query.property('property:animation') == 'harvesting'"
                    }
                ]
            },
            "geometry": {
                "male": "geometry.tektopia_farmer_male",
                "female": "geometry.tektopia_farmer_female"
            },
            "textures": {
                "male": "textures/entity/farmer_male",
                "female": "textures/entity/farmer_female"
            },
            "materials": {
                "default": "entity"
            },
            "render_controllers": [
                "controller.render.tektopia_villager"
            ],
            "spawn_egg": {
                "base_color": "#446600",
                "overlay_color": "#00FF44"
            }
        }
    }
}